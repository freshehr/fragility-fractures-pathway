archetype (adl_version=1.4; uid=8d2a7a61-0c47-4a8e-9f3e-5b7d0c2e6a11)
	openEHR-EHR-OBSERVATION.dxa_bone_densitometry.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-10-21">
		["name"] = <"Draft for FLS Registry template">
	>
	lifecycle_state = <"in_development">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the measured results of a dual-energy X-ray absorptiometry (DXA) bone density scan, including bone mineral density, T-score and Z-score per measured site.">
			keywords = <"DXA","DEXA","bone density","BMD","T-score","Z-score","osteoporosis","densitometry">
			use = <"Use to record DXA results for osteoporosis assessment, for example within a Fracture Liaison Service.

Each measured skeletal site is recorded in a 'Measurement site' cluster. The lowest T-score across all sites, which drives WHO classification and treatment decisions, can be recorded once at the top level.

The full narrative DXA report, if needed, can be recorded with OBSERVATION.imaging_exam_result.">
			misuse = <"Not to be used for quantitative CT or ultrasound bone densitometry without review.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
		["custodian_organisation"] = <"Local">
		["references"] = <"World Health Organization. Assessment of fracture risk and its application to screening for postmenopausal osteoporosis. WHO Technical Report Series 843. Geneva: WHO; 1994.">
		["original_namespace"] = <"local">
		["revision"] = <"0.0.1-alpha">
		["MD5-CAM-1.0.1"] = <"5f39b4e9a9547d5350111afc4fbc39b1">
		["build_uid"] = <"36dcccc2-5155-3b42-b996-b162b598e732">
	>

definition
	OBSERVATION[at0000] matches {    -- DXA bone densitometry result
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {1..*; unordered} matches {
									CLUSTER[at0004] occurrences matches {0..*} matches {    -- Measurement site
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0005] matches {    -- Site
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0006,    -- Lumbar spine
															at0007,    -- Total hip
															at0008,    -- Femoral neck
															at0009]    -- Forearm (one-third radius)
														}
													}
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0010] occurrences matches {0..1} matches {    -- Laterality
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0011,    -- Left
															at0012]    -- Right
														}
													}
												}
											}
											ELEMENT[at0013] occurrences matches {0..1} matches {    -- Bone mineral density
												value matches {
													C_DV_QUANTITY <
														property = <[openehr::349]>
														list = <
															["1"] = <
																units = <"g/cm2">
																magnitude = <|0.0..5.0|>
																precision = <|3|>
															>
														>
													>
												}
											}
											ELEMENT[at0014] occurrences matches {0..1} matches {    -- T-score
												value matches {
													C_DV_QUANTITY <
														property = <[openehr::380]>
														list = <
															["1"] = <
																units = <"1">
																magnitude = <|-10.0..10.0|>
																precision = <|1|>
															>
														>
													>
												}
											}
											ELEMENT[at0015] occurrences matches {0..1} matches {    -- Z-score
												value matches {
													C_DV_QUANTITY <
														property = <[openehr::380]>
														list = <
															["1"] = <
																units = <"1">
																magnitude = <|-10.0..10.0|>
																precision = <|1|>
															>
														>
													>
												}
											}
											ELEMENT[at0016] occurrences matches {0..1} matches {    -- Comment
												value matches {
													DV_TEXT matches {*}
												}
											}
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {    -- Lowest T-score
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::380]>
												list = <
													["1"] = <
														units = <"1">
														magnitude = <|-10.0..10.0|>
														precision = <|1|>
													>
												>
											>
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {    -- Site of lowest T-score
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {    -- WHO classification
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0020,    -- Normal
													at0021,    -- Low bone mass (osteopenia)
													at0022]    -- Osteoporosis
												}
											}
										}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0024] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0025] occurrences matches {0..1} matches {    -- Reference database
						value matches {
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0026] occurrences matches {0..1} matches {    -- Device
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.device(-[a-zA-Z0-9_]+)*\.v1/}
					}
					allow_archetype CLUSTER[at0027] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"DXA bone densitometry result">
					description = <"The measured results of a dual-energy X-ray absorptiometry (DXA) bone density scan.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Measurement site">
					description = <"Results for one measured skeletal site.">
				>
				["at0005"] = <
					text = <"Site">
					description = <"The skeletal site measured.">
				>
				["at0006"] = <
					text = <"Lumbar spine">
					description = <"Lumbar spine, usually L1-L4.">
				>
				["at0007"] = <
					text = <"Total hip">
					description = <"Total proximal femur.">
				>
				["at0008"] = <
					text = <"Femoral neck">
					description = <"Femoral neck region of the proximal femur.">
				>
				["at0009"] = <
					text = <"Forearm (one-third radius)">
					description = <"Distal one-third radius of the non-dominant forearm.">
				>
				["at0010"] = <
					text = <"Laterality">
					description = <"The side of the body measured, where relevant.">
				>
				["at0011"] = <
					text = <"Left">
					description = <"The left side.">
				>
				["at0012"] = <
					text = <"Right">
					description = <"The right side.">
				>
				["at0013"] = <
					text = <"Bone mineral density">
					description = <"Areal bone mineral density (BMD) measured at the site.">
				>
				["at0014"] = <
					text = <"T-score">
					description = <"Number of standard deviations the measured BMD differs from the young adult reference mean.">
				>
				["at0015"] = <
					text = <"Z-score">
					description = <"Number of standard deviations the measured BMD differs from the age- and sex-matched reference mean.">
				>
				["at0016"] = <
					text = <"Comment">
					description = <"Additional narrative about the measurement at this site, for example artefact affecting the result.">
				>
				["at0017"] = <
					text = <"Lowest T-score">
					description = <"The lowest T-score recorded across all measured sites.">
				>
				["at0018"] = <
					text = <"Site of lowest T-score">
					description = <"The skeletal site at which the lowest T-score was recorded.">
				>
				["at0019"] = <
					text = <"WHO classification">
					description = <"Classification of bone density using the WHO T-score thresholds.">
				>
				["at0020"] = <
					text = <"Normal">
					description = <"T-score -1.0 or above.">
				>
				["at0021"] = <
					text = <"Low bone mass (osteopenia)">
					description = <"T-score between -1.0 and -2.5.">
				>
				["at0022"] = <
					text = <"Osteoporosis">
					description = <"T-score -2.5 or below.">
				>
				["at0023"] = <
					text = <"Comment">
					description = <"Additional narrative about the DXA result not captured in other fields.">
				>
				["at0024"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0025"] = <
					text = <"Reference database">
					description = <"The reference population database used to calculate T-scores and Z-scores, for example NHANES III.">
				>
				["at0026"] = <
					text = <"Device">
					description = <"Details of the DXA scanner used.">
				>
				["at0027"] = <
					text = <"Extension">
					description = <"Additional information required to capture local content or to align with other reference models/formalisms.">
				>
			>
		>
	>
